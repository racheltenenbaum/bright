# Used by `vite build --mode staging` (scripts/ios-staging.sh): the "bright stg"
# iOS app talks to the staging Railway environment, never production.
VITE_API_URL=https://bright-staging.up.railway.app
VITE_APP_URL=https://brightfe-staging.up.railway.app
VITE_SENTRY_ENVIRONMENT=staging
# Keep test taps out of the real Mixpanel numbers (empty = analytics off).
VITE_MIXPANEL_TOKEN=
# Not a VITE_ var (so not in the web bundle): read by scripts/ios-staging.sh.
# Google iOS sign-in client for the com.racheltenenbaum.bright.staging app.
GOOGLE_IOS_CLIENT_ID_STAGING=838539937170-j2esuhctsvaq8tfuu0e500fsctc9vadc.apps.googleusercontent.com
