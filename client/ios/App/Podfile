require_relative '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAppleSignIn', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor-community/apple-sign-in'
  pod 'CapacitorCommunityBackgroundGeolocation', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor-community/background-geolocation'
  pod 'CapacitorCommunityTextToSpeech', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor-community/text-to-speech'
  pod 'CapacitorApp', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor/app'
  pod 'CapacitorGeolocation', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor/geolocation'
  pod 'CapacitorShare', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@capacitor/share'
  pod 'CodetrixStudioCapacitorGoogleAuth', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@codetrix-studio/capacitor-google-auth'
  pod 'SentryCapacitor', :path => '../../../../../../../../../../Users/racheltenenbaum/projects/bright/client/node_modules/@sentry/capacitor'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # GoogleSignIn/GTMAppAuth/GTMSessionFetcher (pulled in transitively via
  # CodetrixStudioCapacitorGoogleAuth) are pinned to old versions that
  # predate Apple's privacy manifest requirement (ITMS-91061). Upgrading
  # them means porting the plugin's Swift code to a breaking-changed API
  # we haven't verified, so instead we inject the manifest Apple requires
  # directly into each pod's build output as a resource.
  privacy_manifest_targets = ['GoogleSignIn', 'GTMAppAuth', 'GTMSessionFetcher']
  template = File.join(__dir__, 'PrivacyManifests', 'PrivacyInfo.xcprivacy')
  installer.pods_project.targets.each do |target|
    next unless privacy_manifest_targets.include?(target.name)
    dest_dir = File.join(installer.sandbox.root, target.name)
    dest = File.join(dest_dir, 'PrivacyInfo.xcprivacy')
    FileUtils.mkdir_p(dest_dir)
    FileUtils.cp(template, dest)
    file_ref = target.project.main_group.find_subpath(target.name, true).new_reference(dest)
    target.resources_build_phase.add_file_reference(file_ref, true)
  end
end
